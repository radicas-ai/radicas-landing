# ── Notion: website leads (server-only — never expose with NEXT_PUBLIC_) ───
# The form writes into "🌐 Website leads" (Go-to-Market → CRM), a quarantine
# queue. Nothing is written to the CRM itself — promoting a lead into People /
# Organizations / Activity log is a separate, human step.
# 1. Create an internal integration at https://www.notion.so/my-integrations
#    (or reuse the CRM integration) and copy its secret here.
# 2. Share the "🌐 Website leads" database with it (••• → Connections).
NOTION_TOKEN=
# Database id (the 32-char hash in the database URL).
NOTION_LEADS_DB_ID=

# ── Cloudflare Turnstile (anti-spam captcha) ───────────────────────────────
# Create a Turnstile site at https://dash.cloudflare.com → Turnstile.
# Add your domains (e.g. radicas.ai + the Vercel preview domain; localhost works
# out of the box). Leave both empty to disable the captcha (dev/preview fallback).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Analytics (optional) ────────────────────────────────────────────
# GA4 measurement id, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
