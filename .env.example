# ── Notion CRM (server-only — never expose with NEXT_PUBLIC_) ──────────────
# 1. Create an internal integration at https://www.notion.so/my-integrations
#    (or reuse the CRM integration) and copy its secret here.
# 2. Share all THREE databases below with that integration (••• → Connections):
#    Organizations, People, and Activity log.
# 3. Add a "Web form" option to the Activity log "Channel" select (Notion UI).
NOTION_TOKEN=
# Database ids (the 32-char hash in each database URL).
NOTION_ORGS_DB_ID=
NOTION_PEOPLE_DB_ID=
NOTION_ACTIVITY_DB_ID=

# ── Cloudflare Turnstile (anti-spam captcha) ───────────────────────────────
# Create a Turnstile site at https://dash.cloudflare.com → Turnstile.
# Add your domains (e.g. radicas.ai + the Vercel preview domain; localhost works
# out of the box). Leave both empty to disable the captcha (dev/preview fallback).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Book a demo CTA ────────────────────────────────────────────────────────
# Calendly / Cal.com link. The button is disabled with a hint until this is set.
NEXT_PUBLIC_BOOKING_URL=

# ── Google Analytics (optional) ────────────────────────────────────────────
# GA4 measurement id, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
